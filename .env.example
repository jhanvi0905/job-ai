# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Notion internal integration token: notion.so/my-integrations -> "+ New integration"
# -> Internal -> copy the "Internal Integration Secret". Then share the
# "Job Pipeline" database with this integration (••• menu on the database -> Connections).
NOTION_API_KEY=

# Only needed if the Job Pipeline database is ever recreated — defaults to the
# one discovered during Phase 0 inspection (Jhanvi — Life OS / Domains / Job Search).
NOTION_JOB_PIPELINE_DB_ID=

# AI/ML API key (https://aimlapi.com/app) — OpenAI-compatible. Used from Phase 2 onward.
AIMLAPI_KEY=

# ---------------------------------------------------------------------------
# Product API (multi-tenant SaaS: src/jobai/product, served on :8100)
# ---------------------------------------------------------------------------

# SQLAlchemy URL. Defaults to local SQLite when unset; docker-compose overrides
# this with the bundled Postgres service. On Supabase use the transaction pooler
# (Dashboard -> Connect -> "Transaction pooler", port 6543); prepared statements
# are disabled automatically for port 6543 or a `?pgbouncer=true` URL.
DATABASE_URL=sqlite:///data/product.db

# Used by `alembic upgrade head` only (falls back to DATABASE_URL). On Supabase
# use the direct or session-pooler connection (port 5432), not the 6543 pooler.
DIRECT_DATABASE_URL=

# Supabase project (Dashboard -> Project Settings -> API). When SUPABASE_URL is
# unset (offline dev/tests) the API can't verify tokens, so authed routes 401,
# uploads go to UPLOAD_DIR and DELETE /me skips the Auth Admin call.
# Required when APP_ENV is not dev.
SUPABASE_URL=
# BACKEND ONLY. Bypasses RLS; used for Storage and the Auth Admin API. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still signs access tokens with the legacy HS256 secret
# (Project Settings -> JWT Keys). Asymmetric (ES256/RS256) keys are fetched from JWKS.
SUPABASE_JWT_SECRET=
# Private Storage bucket for resume uploads (create it in the dashboard; keep it private).
SUPABASE_STORAGE_BUCKET=resumes

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Payment webhook signing secret is PAYMENT_WEBHOOK_SECRET (see the production section).

# Postgres credentials consumed by docker-compose.yml (local dev only).
POSTGRES_USER=jobai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobai

# ---------------------------------------------------------------------------
# Frontend (Next.js) -- NEXT_PUBLIC_* values are inlined at build time.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8100
# Supabase browser client. The anon key is public by design; RLS (enabled with
# no policies on every table) is what keeps the Data API from reading our tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Production backend: worker, observability, security (see docs/RUNBOOK.md)
# ---------------------------------------------------------------------------
# dev | staging | prod. Anything but dev requires SUPABASE_URL and explicit
# CORS_ORIGINS (no '*'); prod also disables /docs + /openapi.json and requires
# https origins. HSTS is sent whenever APP_ENV is not dev.
APP_ENV=dev
# Error reporting (optional). Events are scrubbed: no request bodies, auth
# headers, cookies, local variables, resume or job-description text.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Release tag for logs/Sentry/readiness; set by the Docker build (--build-arg GIT_SHA).
GIT_SHA=
# json (default) | text (human-readable lines for local dev). LOG_LEVEL defaults to INFO.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Postgres-backed rate limits (waitlist 5/h/IP, writes 60/min/user, refresh 6/h, tailor 20/h).
RATE_LIMITS_ENABLED=true
# Worker (scripts/product/run_worker.py): catalog-ingest cadence, queue poll interval,
# and WORKER_SCHEDULE=0 to stop this process from scheduling recurring tasks.
CATALOG_INGEST_INTERVAL_MIN=360
WORKER_POLL_INTERVAL_S=2
WORKER_SCHEDULE=1
# Payment webhook HMAC secret read by services/billing.py (X-Signature header).
PAYMENT_WEBHOOK_SECRET=
# Ops dashboard API (src/jobai/assistant/dashboard_api, never deployed publicly). Bearer token
# required on every route; when unset, dev serves loopback clients only and any
# other APP_ENV refuses to start. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
DASHBOARD_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend production (Vercel) -- see frontend/README.md. Build-time values.
# ---------------------------------------------------------------------------
# Canonical site URL for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Frontend Sentry (browser + Next server). Optional; unset = no-op. Use a separate
# Sentry project from the backend SENTRY_DSN above. Its host is added to the CSP.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Source-map upload during `next build` (CI/Vercel only; keep the token secret).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Contact shown on /privacy and /terms. Set before launch.
NEXT_PUBLIC_LEGAL_EMAIL=
